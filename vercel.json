{
  "headers": [
    {
      "source": "/e",
      "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors *" }]
    },
    {
      "source": "/((?!e$).*)",
      "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
